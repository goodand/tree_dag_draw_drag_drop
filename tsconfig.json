{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "simple-mind-map": ["./vendor/simple-mind-map/index.js"], "simple-mind-map/*": ["./vendor/simple-mind-map/*"] }
  },
  "include": ["src"]
}
